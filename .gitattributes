* text=auto

# Unity YAML assets: fixed line endings so Windows and Linux checkouts produce identical diffs
*.cs text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.inputactions text eol=lf
*.json text eol=lf

*.png binary
*.jpg binary
*.fbx binary
*.npz binary
